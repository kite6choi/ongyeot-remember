# 온곁 리멤버 환경 변수 예시
# .env 파일을 만들고 실제 값으로 채우세요 (절대 커밋하지 마세요)

# 프론트엔드 (Vite)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Edge Function Secrets (supabase secrets set 명령으로 등록)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_CHAT=gpt-5.4-mini
# OPENAI_MODEL_LIGHT=gpt-5.4-nano
# RISK_CLASSIFY_TIMEOUT_MS=1500
# TRIAL_DAILY_TURN_LIMIT=30
# GLOBAL_DAILY_USD_LIMIT=3
# ADMIN_VIEW_KEY=임의_문자열
